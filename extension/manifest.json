{
  "manifest_version": 3,
  "name": "Signal Shelf",
  "version": "2.5.0",
  "description": "Save YouTube videos and podcast episodes with their transcripts. Rate them, and let Claude read what you learned.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://itunes.apple.com/*",
    "https://signalshelf.jake-1c4.workers.dev/*",
    "http://127.0.0.1:3456/*",
    "http://localhost:3456/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Signal Shelf",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "history.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://signalshelf.jake-1c4.workers.dev/app/*",
        "http://127.0.0.1:3456/*",
        "http://localhost:3456/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
